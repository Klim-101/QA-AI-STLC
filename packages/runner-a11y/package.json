{
  "name": "@qa-ai-stlc/runner-a11y",
  "version": "1.6.0",
  "description": "Runner that executes Playwright specs for a11y test cases and records their axe-core scans as accessibility evidence.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Klim-101/QA-AI-STLC/tree/main/packages/runner-a11y#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Klim-101/QA-AI-STLC.git",
    "directory": "packages/runner-a11y"
  },
  "bugs": "https://github.com/Klim-101/QA-AI-STLC/issues",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "pretypecheck": "npm run build --workspace @qa-ai-stlc/schemas --workspace @qa-ai-stlc/core --workspace @qa-ai-stlc/runner-playwright --workspace @qa-ai-stlc/test-utils",
    "typecheck": "tsc --noEmit -p .",
    "pretest": "npm run build --workspace @qa-ai-stlc/schemas --workspace @qa-ai-stlc/core --workspace @qa-ai-stlc/runner-playwright --workspace @qa-ai-stlc/test-utils",
    "test": "vitest run",
    "pretest:coverage": "npm run build --workspace @qa-ai-stlc/schemas --workspace @qa-ai-stlc/core --workspace @qa-ai-stlc/runner-playwright --workspace @qa-ai-stlc/test-utils",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -b tsconfig.build.json",
    "clean": "node ../../scripts/clean-dir.mjs dist"
  },
  "dependencies": {
    "@qa-ai-stlc/core": "1.6.0",
    "@qa-ai-stlc/runner-playwright": "1.6.0"
  },
  "devDependencies": {
    "@qa-ai-stlc/test-utils": "0.0.0"
  }
}
