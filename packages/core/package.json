{
  "name": "@qa-ai-stlc/core",
  "version": "0.0.0",
  "description": "The QA-AI-STLC engine: .qa/ store, manifest hashing, config loading, and the injected clock/file-system/logger ports every other package builds on.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "pretypecheck": "npm run build --workspace @qa-ai-stlc/schemas --workspace @qa-ai-stlc/test-utils",
    "typecheck": "tsc --noEmit -p .",
    "pretest": "npm run build --workspace @qa-ai-stlc/schemas --workspace @qa-ai-stlc/test-utils",
    "test": "vitest run",
    "pretest:coverage": "npm run build --workspace @qa-ai-stlc/schemas --workspace @qa-ai-stlc/test-utils",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -b tsconfig.build.json",
    "clean": "node ../../scripts/clean-dir.mjs dist"
  },
  "dependencies": {
    "@qa-ai-stlc/schemas": "0.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@qa-ai-stlc/test-utils": "0.0.0"
  }
}
