{
  "name": "@qa-ai-stlc/runner-security",
  "version": "1.6.0",
  "description": "On-demand, non-destructive black-box security audit: an authorization-gated probe, security checks and findings registered as evidence and defect drafts.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://github.com/Klim-101/QA-AI-STLC/tree/main/packages/runner-security#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Klim-101/QA-AI-STLC.git",
    "directory": "packages/runner-security"
  },
  "bugs": "https://github.com/Klim-101/QA-AI-STLC/issues",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "pretypecheck": "npm run build --workspace @qa-ai-stlc/schemas --workspace @qa-ai-stlc/core --workspace @qa-ai-stlc/test-utils",
    "typecheck": "tsc --noEmit -p .",
    "pretest": "npm run build --workspace @qa-ai-stlc/schemas --workspace @qa-ai-stlc/core --workspace @qa-ai-stlc/test-utils",
    "test": "vitest run",
    "pretest:coverage": "npm run build --workspace @qa-ai-stlc/schemas --workspace @qa-ai-stlc/core --workspace @qa-ai-stlc/test-utils",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -b tsconfig.build.json",
    "clean": "node ../../scripts/clean-dir.mjs dist"
  },
  "dependencies": {
    "@qa-ai-stlc/core": "1.6.0",
    "@qa-ai-stlc/schemas": "1.6.0"
  },
  "devDependencies": {
    "@qa-ai-stlc/test-utils": "0.0.0"
  }
}
