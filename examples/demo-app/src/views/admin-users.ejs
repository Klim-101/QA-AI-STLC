<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Users — Demo App</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <%- include('partials/_nav', { user }) %>
    <main>
      <h1>Users</h1>
      <table>
        <thead>
          <tr>
            <th>Email</th>
            <th>Role</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function (row) { %>
          <tr>
            <td><%= row.email %></td>
            <td><%= row.role %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </main>
  </body>
</html>
