{
  "name": "qa-ai-stlc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Klim-101/QA-AI-STLC.git"
  },
  "bugs": "https://github.com/Klim-101/QA-AI-STLC/issues",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/run-workspaces.mjs build",
    "typecheck": "node scripts/run-workspaces.mjs typecheck",
    "lint": "node scripts/check-llm-denylist.mjs && eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "licenses:check": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0;Unlicense;BlueOak-1.0.0;Python-2.0\"",
    "pretest": "npm run build",
    "test": "vitest run --passWithNoTests",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "node scripts/run-workspaces.mjs clean",
    "pack:check": "node scripts/pack-check.mjs",
    "release": "npm run pack:check && changeset publish",
    "demo": "npm run start --workspace @qa-ai-stlc/demo-app"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
