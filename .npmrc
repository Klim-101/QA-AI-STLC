# Fail fast on a Node version outside package.json engines, instead of installing anyway.
engine-strict=true
# Pin exact versions on `npm install <pkg>`, matching the exact-version policy in AGENTS.md §5.7.
save-exact=true
# Every `npm publish` from the release workflow carries provenance (AGENTS.md 8.4); a no-op
# locally, since provenance requires the OIDC context CI provides.
provenance=true
